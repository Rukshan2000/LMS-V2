NODE_ENV=development
PORT=4000
# Local PostgreSQL 16 (Homebrew, port 5432). Database: LMS_V2.
# App runtime connects as the restricted role lms_app (RLS applies).
DATABASE_URL=postgres://lms_app:lms_app@127.0.0.1:5432/LMS_V2
# Migrations run as the table owner (superuser locally).
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/LMS_V2
# Tests use a separate database; it is wiped on every test run.
TEST_DATABASE_URL=postgres://lms_app:lms_app@127.0.0.1:5432/LMS_V2_test
TEST_MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/LMS_V2_test
