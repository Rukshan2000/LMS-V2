NODE_ENV=development
PORT=4000
# Local PostgreSQL 16 (Homebrew). Database: tuition_lms.
# App connects as the restricted role (RLS applies). Role is created in Step 2.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/tuition_lms
# Migrations run as the table owner.
MIGRATION_DATABASE_URL=postgres://lms_owner:lms_owner@localhost:5432/tuition_lms
